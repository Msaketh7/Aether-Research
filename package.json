{
  "name": "aether-research",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "Aether Research - autonomous multi-agent research platform (monorepo root)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aether/web",
    "app": "python scripts/dev.py",
    "app:api": "python scripts/dev.py --no-web",
    "build": "npm run build --workspace @aether/web",
    "start": "npm run start --workspace @aether/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @aether/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md,yml,yaml}": "prettier --write"
  }
}
