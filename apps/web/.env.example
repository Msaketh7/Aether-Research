# apps/web only reads NEXT_PUBLIC_* values. Secrets live in the API process.
# See the repository root .env.example for the full configuration surface.

# mock -> /api/mock/v1 route handlers (Phase 1, no backend needed)
# live -> NEXT_PUBLIC_API_BASE_URL (Phase 2+)
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Aether Research

# Multiplier applied to the simulated research timeline in mock mode.
# 1 = realistic pacing, 12 = fast (used by the Playwright suite).
NEXT_PUBLIC_MOCK_SPEED=1

# The prefix of the cookies the API sets. The middleware reads the access
# cookie (<prefix>_at) to decide where to route a visitor, so this must match
# SESSION_COOKIE_NAME in the API's settings. A mismatch is not a security
# problem - the API still validates what it receives - but every signed-in
# person looks signed out to the router.
NEXT_PUBLIC_SESSION_COOKIE_NAME=aether_session
