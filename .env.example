# ---------------------------------------------------------------------------
# Aether Research - example environment
# Copy to .env and fill in. NEVER commit .env.
# Only NEXT_PUBLIC_* values reach the browser; secrets must stay server-side.
# ---------------------------------------------------------------------------

# --- Frontend (apps/web) ---------------------------------------------------
# mock  -> the Next.js route handlers under /api/mock/v1 serve deterministic
#          fixtures (Phase 1: no backend required)
# live  -> requests go to NEXT_PUBLIC_API_BASE_URL (Phase 2+)
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Aether Research


# --- API (apps/api, Phase 2+) ----------------------------------------------
APP_ENV=local
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Authentication and sessions (Phase 20, ADR 0021) ----------------------
# Sessions are rows, not signed tokens: the cookie carries 256 bits of
# opaque randomness and the server holds a SHA-256 of it, so revoking a
# device takes effect on its next request.
REGISTRATION_ENABLED=true
# Only honoured in APP_ENV=local and test, where X-Aether-User and the
# default developer principal work. It can close that gate further; it can
# never open it in staging or production.
DEV_IDENTITY_ENABLED=true
MIN_PASSWORD_LENGTH=12
# Argon2id, at RFC 9106's low-memory profile. Raise them on bigger
# hardware: existing passwords are re-hashed at their next sign-in, so
# nobody is locked out by the change.
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_PARALLELISM=4
SESSION_COOKIE_NAME=aether_session
# Unset means a host-only cookie. Set a parent domain only to share the
# session across subdomains - every subdomain then receives it.
SESSION_COOKIE_DOMAIN=
# lax is enough while the web app and the API share a registrable domain.
# `none` is for a deployment that genuinely splits them, and browsers only
# honour it with Secure - which the settings validator enforces.
SESSION_COOKIE_SAMESITE=lax
# Unset resolves by environment: on everywhere but local and test.
SESSION_COOKIE_SECURE=
SESSION_TTL_SECONDS=1209600
MAX_SESSIONS_PER_USER=10
# How many trusted proxies sit in front of this process. 0 means the
# socket peer is the client and X-Forwarded-For is ignored entirely; set it
# to the real number behind a load balancer. Trusting the header by its
# presence would let any caller pick their own rate-limit bucket and forge
# the address written into the audit log.
TRUSTED_PROXY_HOPS=0

# --- Rate limiting (Phase 20) ----------------------------------------------
# Token buckets per identity and route class. `BURST` is what may be spent
# at once after being idle; `PER_MINUTE` is the sustained ceiling.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_READ_BURST=60
# Writes start work - a run, a follow-up, an upload - so they are tighter.
RATE_LIMIT_WRITE_PER_MINUTE=20
RATE_LIMIT_WRITE_BURST=10
# Credential attempts, bucketed by client address *and* by the address
# being attempted, so stuffing one account from many clients is bounded too.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AUTH_BURST=5

# --- Datastores (Phase 3+) -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether
REDIS_URL=redis://localhost:6379/0

# --- Object storage (Phase 4) ----------------------------------------------
# s3         -> MinIO locally (`make up`), AWS S3 in production
# filesystem -> a local directory; development without Docker only, refused in
#               production because artifacts would not survive a deploy
STORAGE_BACKEND=s3
# STORAGE_LOCAL_PATH=.data/object-storage   # filesystem backend only

# Leave S3_ENDPOINT_URL empty for real AWS S3. Leave the credentials empty in
# production so the ECS task role is used instead of long-lived keys.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=aether-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# auto -> path style for a custom endpoint (MinIO), virtual-host for AWS
S3_ADDRESSING_STYLE=auto
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_ATTEMPTS=3
# Ceiling on one artifact, enforced on upload and download. 25 MiB.
MAX_ARTIFACT_BYTES=26214400

# --- LLM gateway (Phase 5) -------------------------------------------------
# Which models exist, what they cost and which tier they serve is declared in
# apps/api/app/models/registry.yaml, not here. Leave a key empty and that
# provider is simply not built; Ollama needs none, which is what lets the whole
# agent graph run locally without an account anywhere.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Absolute path to override the shipped model registry.
# MODEL_REGISTRY_PATH=

# Bounds on every model call. A model call is the slowest and most expensive
# thing the system does, so none of these is unbounded.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8
# 50 parallel researchers become this many concurrent calls; the rest queue.
LLM_MAX_CONCURRENT_CALLS=8

# --- Research tools (Phase 6) ----------------------------------------------
# Leave both search keys empty and web_search refuses with the setting named,
# rather than failing with a 401 from a vendor.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
# SEC requires a descriptive User-Agent with a real contact address and blocks
# anonymous scrapers. Put your own address here before running against EDGAR.
SEC_USER_AGENT="AetherResearch/0.1 (contact@example.com)"
# Optional. Without it GitHub search allows ~10 requests/minute; with it, 30.
# Code search requires it entirely.
GITHUB_TOKEN=

# Bounds on every outbound fetch.
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_READ_TIMEOUT_SECONDS=20
FETCH_MAX_RESPONSE_BYTES=5242880
FETCH_MAX_REDIRECTS=5
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_ATTEMPTS=3
TOOL_MAX_CONCURRENT_CALLS=8

# Per-deployment SSRF policy (comma-separated). ALLOWED_DOMAINS empty means any
# public host; setting it makes the fetcher allowlist-only. Private, loopback,
# link-local and cloud-metadata addresses are always refused regardless.
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=

# --- Run governance (Phase 9/16) -------------------------------------------
MAX_RESEARCH_ITERATIONS=4
MAX_SOURCES=50
MAX_SEARCH_QUERIES=30
MAX_RUNTIME_SECONDS=300
MAX_ESTIMATED_COST_USD=2.00
# Research graph (Phase 9, ADR 0014): subtasks one planning round may dispatch
# (a plan may propose up to 20), researchers running at once, the most any one
# node may run, and the checkpointer's own connection pool.
MAX_SUBTASKS_PER_ITERATION=8
GRAPH_MAX_CONCURRENCY=4
GRAPH_NODE_TIMEOUT_SECONDS=120
CHECKPOINT_POOL_SIZE=4

# --- Agents (Phase 10, ADR 0015) ---------------------------------------------
# Pages one researcher fetches and ingests at once. Multiplied by
# GRAPH_MAX_CONCURRENCY, since that many researchers run in parallel: the
# product is the run's concurrent fetches and database sessions.
RESEARCHER_FETCH_CONCURRENCY=2
# Search results requested per query, before deduplication and selection.
RESEARCHER_RESULTS_PER_QUERY=10
# Retrieved passages one evidence-extraction call reads, and how many such
# calls a round may make. Together they bound how much of a large round is
# read at all, and a round that exceeds them says so in the log.
EVIDENCE_PASSAGES_PER_CALL=12
EVIDENCE_MAX_CALLS_PER_ROUND=3

# --- Document ingestion (Phase 7, ADR 0012) ----------------------------------
# Uploads are refused above this size while the body is read. Unset means
# MAX_ARTIFACT_BYTES; a value above that is refused at startup.
# MAX_UPLOAD_BYTES=26214400
# Each document is parsed in a child process that is killed at this deadline.
PARSE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_PARSES=2
PARSE_MAX_MEMORY_BYTES=2147483648
MAX_PDF_PAGES=1000
MAX_DOCUMENT_CHARS=2000000
# Chunk size and overlap in cl100k tokens. ADR 0012 records why these values.
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MAX_CHUNKS_PER_DOCUMENT=2000
EMBEDDING_BATCH_SIZE=64

# --- Retrieval (Phase 8, ADR 0013) -----------------------------------------
# Chunks a search returns, and candidates each arm fetches before fusion.
RETRIEVAL_LIMIT=10
RETRIEVAL_CANDIDATES=50
# Reciprocal Rank Fusion's rank constant, from the paper that introduced it.
RETRIEVAL_RRF_K=60
# Relative trust in each arm. Zero disables one: a deployment with no
# embeddings sets RETRIEVAL_DENSE_WEIGHT=0 and the arm reports itself skipped.
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_LEXICAL_WEIGHT=1.0
# Reranking, and how far it trades relevance for coverage. 1.0 is pure relevance.
RETRIEVAL_RERANK=true
RETRIEVAL_MMR_LAMBDA=0.7

# --- Worker (Phase 13, ADR 0005) ---------------------------------------------
# Runs one worker process executes at once. A run is mostly waiting on the
# network, so a process can hold several; scale past this with more processes.
WORKER_CONCURRENCY=1
# How long the worker blocks for a job before ticking. The tick is what runs
# the reconciliation sweep and notices a shutdown signal.
WORKER_POLL_SECONDS=5
# Attempts a run gets before it is failed. An attempt is counted when a worker
# claims the run, so a process killed mid-run spends one - which is what stops
# a run that crashes its worker from doing it forever. A worker asked to stop
# hands the run back and returns the attempt.
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_SECONDS=10
WORKER_RETRY_MAX_DELAY_SECONDS=600
# How long a worker's claim on a run is honoured without a heartbeat. At least
# twice GRAPH_NODE_TIMEOUT_SECONDS - the heartbeat is written at node
# boundaries, so a shorter lease is taken from a worker that is still healthy.
WORKER_LEASE_SECONDS=600
# The reconciliation sweep: how often it runs, how long a run may sit queued
# before its job is presumed lost, and how many it re-dispatches at a time.
WORKER_SWEEP_INTERVAL_SECONDS=30
WORKER_QUEUED_GRACE_SECONDS=60
WORKER_SWEEP_BATCH=100
# How long a stopping worker waits for its runs to reach a checkpoint.
WORKER_SHUTDOWN_GRACE_SECONDS=30

# --- Streaming (Phase 14, ADR 0006) ------------------------------------------
# How long the Redis fan-out keeps a run's buffered events and its counter.
# Long enough to cover a reconnect during a run; a client reconnecting later
# is served from research_events instead.
SSE_EVENT_BUFFER_TTL_SECONDS=3600
# Whether every streamed event is also written to research_events. Turning
# it off makes replay depend on the Redis buffer, which is bounded and
# expires - a real trade, so it is a real setting.
PERSIST_RESEARCH_EVENTS=true
# Events the replay buffer holds per run, and how long a stream is held
# open before the browser is asked to reconnect with Last-Event-ID.
SSE_REPLAY_BUFFER_SIZE=500
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CONNECTION_SECONDS=900

# --- Caching (Phase 15, TDD 13) ----------------------------------------------
# Off still coalesces simultaneous identical calls: doing one piece of work
# once and remembering it afterwards are two different promises.
CACHE_ENABLED=true
# Short for a search answer, medium for a fetched page and the article
# extracted from it, long for an embedding - which is deterministic.
CACHE_SEARCH_TTL_SECONDS=21600
CACHE_PAGE_TTL_SECONDS=259200
CACHE_EMBEDDING_TTL_SECONDS=2592000
# The embedding key is a hash of the exact text, so a lookup requires
# already having the content. A deployment that would rather not cache a
# function of user documents at all sets this false and pays again.
CACHE_EMBEDDINGS=true
# Refuse to store a value larger than this, and how many entries the
# in-process backend holds.
CACHE_MAX_VALUE_BYTES=1048576
CACHE_MAX_ENTRIES=2048
# --- Cost governance (Phase 16, FR-8) ----------------------------------------
# Whether a run under a cost ceiling may call a model the registry does not
# price. Refused by default: a run whose spend cannot be measured cannot be
# held to a limit, and the limit is the promise. The refusal fails over to
# the next model in the chain, so a chain with one priced model still works.
REQUIRE_PRICED_MODELS=true
# --- Observability (Phase 17) ----------------------------------------------
# Where spans go. Unset means no tracer provider is installed at all: every
# span in the code still runs against the API's no-op implementation, costs
# almost nothing and records nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aether-api
# Prometheus. The API serves /metrics; the worker serves nothing else, so it
# opens a socket of its own on this port (see infra/monitoring/prometheus.yml).
# Neither endpoint carries user data - no run ids, no queries, no URLs - but
# neither belongs on a public interface either.
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100
# LangSmith sends prompts and retrieved documents to a third party, so it is
# off unless this is true *and* a key is set. Both are read here rather than
# by the library, which would otherwise pick the variable up from any shell.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aether-research
