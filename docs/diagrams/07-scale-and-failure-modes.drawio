<mxfile host="app.diagrams.net" agent="aether-docs" version="24.7.17">
  <diagram id="scale-failure" name="Scale, reliability and failure modes">
<mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="ti" value="Scale and reliability - what was measured, and what breaks next" style="text;html=1;fontSize=23;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="50" y="18" width="1100" height="34" as="geometry"/></mxCell>
    <mxCell id="ts" value="Every figure below was produced on 2026-09-18 by `make loadtest` and `make loadtest-api-local`. Conditions: one throttled laptop CPU, real Postgres / queue / lease / graph / nine agents / toolbelt / ingestion / projections; the model provider and the socket are scripted, the provider answering at a declared 0.5 s. Read these as ratios, not as capacity." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="54" width="1800" height="38" as="geometry"/></mxCell>

    <mxCell id="zA" value="1.  MEASURED CAPACITY - 370 research runs, nothing lost, nothing failed" style="rounded=1;arcSize=3;html=1;fillColor=#f1f8ee;strokeColor=#9ac48b;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3f6b30;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="880" height="455" as="geometry"/></mxCell>

    <mxCell id="a1" value="&lt;b&gt;Offered load&lt;/b&gt;&lt;br&gt;10 / 25 / 50 / 100 concurrent research jobs,&lt;br&gt;each profile from an empty database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="380" height="72" as="geometry"/></mxCell>
    <mxCell id="a2" value="&lt;b&gt;Queue wait - GROWS, linearly with the backlog&lt;/b&gt;&lt;br&gt;P50&#160; 16.1 &#8594; 19.1 &#8594; 39.5 &#8594; 79.9 s&lt;br&gt;&lt;i&gt;this is the only thing that moves&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="390" height="72" as="geometry"/></mxCell>
    <mxCell id="a3" value="&lt;b&gt;4 execution slots&lt;/b&gt;&lt;br&gt;one worker process, worker_concurrency = 4,&lt;br&gt;held constant across all four loads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="258" width="380" height="72" as="geometry"/></mxCell>
    <mxCell id="a4" value="&lt;b&gt;Run execution - FLAT&lt;/b&gt;&lt;br&gt;P50&#160; 5.6 &#8594; 6.0 &#8594; 6.1 &#8594; 6.15 s&lt;br&gt;P95 at 100 offered is &lt;b&gt;6.9 s - lower than at 10&lt;/b&gt;&lt;br&gt;&lt;i&gt;a run does not get slower as the system fills up&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="510" y="258" width="390" height="86" as="geometry"/></mxCell>
    <mxCell id="a5" value="&lt;b&gt;Throughput flattens at 37.9 runs/min&lt;/b&gt; - and that is not a scaling gain. The four slots are the same four slots; what changes is that the ramp disappears into the average. 37.9 is this machine's real capacity at four slots. Repeat-to-repeat variance is about 2 runs/min, so anything smaller is noise and is called noise." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=8;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="366" width="820" height="72" as="geometry"/></mxCell>
    <mxCell id="a6" value="&lt;b&gt;THE READING:&lt;/b&gt;&#160; execution latency does not move with load, and everything that grows is queue wait. That is a system &lt;b&gt;queueing, not degrading&lt;/b&gt; - which is the single property the async architecture was chosen for. A degrading system would show execution climbing with load, and the fix for that is a different fix: it would mean runs contending with each other rather than waiting for a slot." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;spacing=8;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="452" width="820" height="88" as="geometry"/></mxCell>

    <mxCell id="zB" value="2.  THE BOTTLENECK LADDER - 50 offered jobs, two repetitions per point so the noise is visible rather than assumed" style="rounded=1;arcSize=3;html=1;fillColor=#fff6ec;strokeColor=#e0b273;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#9a5f10;" vertex="1" parent="1"><mxGeometry x="50" y="585" width="880" height="470" as="geometry"/></mxCell>

    <mxCell id="b1" value="&lt;b&gt;worker_concurrency = 4&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;33.5 runs/min&lt;br&gt;0% of model calls queued&#160;&#160;&#183;&#160;&#160;peak 5 db connections in use, 0 overflow&lt;br&gt;&lt;i&gt;nothing is binding except the slots themselves&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="820" height="72" as="geometry"/></mxCell>
    <mxCell id="b2" value="&lt;b&gt;worker_concurrency = 8&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;50.2 runs/min&#160;&#160;&lt;b&gt;( +50% )&lt;/b&gt;&lt;br&gt;0% of model calls queued&#160;&#160;&#183;&#160;&#160;peak 9 db connections in use, 0 overflow&lt;br&gt;&lt;i&gt;the slots were the constraint, and doubling them paid in full&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="718" width="820" height="72" as="geometry"/></mxCell>
    <mxCell id="b3" value="&lt;b&gt;worker_concurrency = 16&lt;/b&gt;&#160;&#160;&#8594;&#160;&#160;52.2 runs/min&#160;&#160;&lt;b&gt;( +4% )&lt;/b&gt;&lt;br&gt;&lt;b&gt;12.5% - 15.2% of model calls began waiting for a gateway slot&lt;/b&gt; (llm_max_concurrent_calls = 8)&lt;br&gt;&lt;b&gt;the database pool went into overflow&lt;/b&gt; - 15 connections in use against a base of 10&lt;br&gt;&lt;i&gt;two other ceilings appear at once, and the gain stops&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="806" width="820" height="86" as="geometry"/></mxCell>
    <mxCell id="b4" value="&lt;b&gt;THE RELATIONSHIP, now measured rather than guessed:&lt;/b&gt;&#160; raising &lt;i&gt;worker_concurrency&lt;/i&gt; past 8 without also raising &lt;i&gt;llm_max_concurrent_calls&lt;/i&gt; and &lt;i&gt;db_pool_size&lt;/i&gt; &lt;b&gt;moves the bottleneck instead of removing it&lt;/b&gt;. The three settings are coupled, and that note lives beside the setting in app/core/config.py, where an operator raising it will read it.&lt;br&gt;&lt;br&gt;The shipped default of &lt;b&gt;worker_concurrency = 1 was deliberately not changed&lt;/b&gt;: this is one throttled laptop with a scripted provider, and the deployment model is horizontal (ADR 0008), where one run per task makes resource accounting and autoscaling mean something." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=8;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="908" width="820" height="128" as="geometry"/></mxCell>

    <mxCell id="zC" value="3.  FAILURE MODES - what triggers it, what notices, what recovers it, and what the user sees" style="rounded=1;arcSize=3;html=1;fillColor=#f7f2fb;strokeColor=#b79bd0;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#6a4a8c;" vertex="1" parent="1"><mxGeometry x="970" y="105" width="880" height="950" as="geometry"/></mxCell>

    <mxCell id="c1" value="&lt;b&gt;Worker killed, redeployed, or partitioned away&lt;/b&gt;&lt;br&gt;&lt;b&gt;Notices:&lt;/b&gt; the run's heartbeat_at goes stale; any other worker's reconciliation sweep sees it.&lt;br&gt;&lt;b&gt;Recovers:&lt;/b&gt; the run is re-dispatched and resumes &lt;i&gt;from the last checkpoint&lt;/i&gt;, not from the start. Repeated work is harmless because ingestion and writes are idempotent on content hash and natural key.&lt;br&gt;&lt;b&gt;User sees:&lt;/b&gt; the stream pauses and continues. No lost run, no double charge." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="820" height="118" as="geometry"/></mxCell>

    <mxCell id="c2" value="&lt;b&gt;The queue delivers the same run twice&lt;/b&gt;&#160;&#160;- expected, not exceptional&lt;br&gt;&lt;b&gt;Notices:&lt;/b&gt; nothing has to. The queue is at-least-once by design and the sweep deliberately re-dispatches runs it cannot tell are still moving.&lt;br&gt;&lt;b&gt;Recovers:&lt;/b&gt; claiming is one conditional UPDATE with the row's state in the WHERE clause. Exactly one worker changes a row; the other changed none and drops the job. No locks anywhere.&lt;br&gt;&lt;b&gt;User sees:&lt;/b&gt; nothing at all." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="284" width="820" height="118" as="geometry"/></mxCell>

    <mxCell id="c3" value="&lt;b&gt;A model provider throttles, times out, or goes down&lt;/b&gt;&lt;br&gt;&lt;b&gt;Notices:&lt;/b&gt; the gateway - every call has a timeout, a retry policy and an error class.&lt;br&gt;&lt;b&gt;Recovers:&lt;/b&gt; retry with backoff and jitter, then failover to another declared provider. A concurrency semaphore (8) keeps a burst of researchers from becoming a burst of provider calls.&lt;br&gt;&lt;b&gt;NOT MEASURED:&lt;/b&gt; a real provider's throttling and tail latency are outside every number on this page. The provider was held at a declared constant." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="418" width="820" height="118" as="geometry"/></mxCell>

    <mxCell id="c4" value="&lt;b&gt;A run hits a hard ceiling&lt;/b&gt;&#160;&#160;- max_iterations 4, max_sources 50, max_cost $2, max_runtime 5 min&lt;br&gt;&lt;b&gt;Notices:&lt;/b&gt; the FR-8 gate, checked &lt;i&gt;before&lt;/i&gt; each call rather than between nodes.&lt;br&gt;&lt;b&gt;Recovers:&lt;/b&gt; this is a normal outcome, not an error. Discovery stops, the first reason is recorded, and the run routes straight to synthesis.&lt;br&gt;&lt;b&gt;User sees:&lt;/b&gt; a finished report carrying an explicit coverage caveat built from measured values." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="552" width="820" height="118" as="geometry"/></mxCell>

    <mxCell id="c5" value="&lt;b&gt;A fetched page tries to instruct the model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Notices:&lt;/b&gt; nothing needs to at runtime - the defence is structural, not detective.&lt;br&gt;&lt;b&gt;Recovers:&lt;/b&gt; content arrives as an untrusted-content type, is wrapped in one delimited block, and the model may only cite by catalogue number. An injected request for a URL produces a number out of range, which is dropped and counted. The tool tier is read-only, and the synthesizer and validator hold no toolbelt.&lt;br&gt;&lt;b&gt;Worst case:&lt;/b&gt; a hostile page obtains a fetch of itself." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="686" width="820" height="128" as="geometry"/></mxCell>

    <mxCell id="c6" value="&lt;b&gt;Readiness fails under a burst&lt;/b&gt;&#160;&#160;- observed once in the 50-user ladder&lt;br&gt;&lt;b&gt;Notices:&lt;/b&gt; GET /health/ready really checks Postgres; 50 simultaneous registrations each holding a connection made that check wait, and it returned 503. Liveness answered in 8-10 ms throughout.&lt;br&gt;&lt;b&gt;Recovers:&lt;/b&gt; the load balancer stops sending traffic for a moment; the orchestrator is &lt;i&gt;not&lt;/i&gt; told to restart the container. That is the two probes doing what they are separated for.&lt;br&gt;&lt;b&gt;Open question:&lt;/b&gt; one failure in forty-five is also the shape that makes a replica flap. Pool sizing (10+5) is a deployment question, not a code one." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="830" width="820" height="128" as="geometry"/></mxCell>

    <mxCell id="c7" value="&lt;b&gt;NOT MEASURED&#160;-&#160;stated plainly, because a load test's credibility is mostly its disclaimers.&lt;/b&gt;&#160; No real model provider. No Redis (the in-memory adapter was used; queue depth, lease and reconciliation are real, Redis's own utilisation is &lt;i&gt;not measured&lt;/i&gt;, not zero). No dense retrieval (no pgvector, so the lexical arm only - a real deployment does more work per run). One worker process: multi-worker lease contention is covered by the scenario suite but has not been load tested." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=8;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1000" y="974" width="820" height="70" as="geometry"/></mxCell>

    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="a1" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="doubling the slots pays in full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="and here it stops" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
