<mxfile host="app.diagrams.net" agent="aether-docs" version="24.7.17">
  <diagram id="hld-container" name="HLD - container view">
<mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Aether Research - High-Level Design (container view)" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="40" as="geometry"/></mxCell>
    <mxCell id="subtitle" value="Modular monolith (ADR 0001): one codebase, three process types, three backing services. The API never runs a research graph." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="58" width="1000" height="24" as="geometry"/></mxCell>

    <mxCell id="zClient" value="CLIENT TIER" style="rounded=1;arcSize=4;html=1;fillColor=#f0f5ff;strokeColor=#9db8e0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#3b5b8c;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1040" height="130" as="geometry"/></mxCell>
    <mxCell id="zApi" value="API PROCESS - FastAPI (apps/api, entrypoint: api).  Validates, persists, enqueues, returns 202. Scales on request concurrency." style="rounded=1;arcSize=4;html=1;fillColor=#f1f8ee;strokeColor=#9ac48b;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#3f6b30;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="1040" height="250" as="geometry"/></mxCell>
    <mxCell id="zRedis" value="REDIS" style="rounded=1;arcSize=4;html=1;fillColor=#fffaeb;strokeColor=#dcc46a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#8a6d1a;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="520" height="180" as="geometry"/></mxCell>
    <mxCell id="zWorker" value="WORKER PROCESS - apps/api, entrypoint: worker.  Runs the graph. No ingress. Scales on queue depth." style="rounded=1;arcSize=4;html=1;fillColor=#f7f2fb;strokeColor=#b79bd0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#6a4a8c;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1040" height="330" as="geometry"/></mxCell>
    <mxCell id="zData" value="DATA PLANE - system of record and artifacts (boundary 5: least-privilege credentials, no shared superuser)" style="rounded=1;arcSize=4;html=1;fillColor=#fff6ec;strokeColor=#e0b273;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#9a5f10;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="1040" height="210" as="geometry"/></mxCell>
    <mxCell id="zExt" value="OUTSIDE THE TRUST BOUNDARY" style="rounded=1;arcSize=4;html=1;fillColor=#fdf0ef;strokeColor=#d99b95;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#9c3f38;" vertex="1" parent="1"><mxGeometry x="1150" y="430" width="440" height="620" as="geometry"/></mxCell>
    <mxCell id="zObs" value="OBSERVABILITY - measured, never inferred. Null means not measured, not zero." style="rounded=1;arcSize=4;html=1;fillColor=#f4f4f4;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="1400" width="1530" height="170" as="geometry"/></mxCell>

    <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;fetch (REST) + native EventSource (SSE)&lt;br&gt;&lt;i&gt;boundary 1: everything from here is untrusted&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="110" y="130" width="380" height="70" as="geometry"/></mxCell>
    <mxCell id="webapp" value="&lt;b&gt;Next.js 16 (apps/web)&lt;/b&gt;&lt;br&gt;App Router, RSC shells, TanStack Query owns server state&lt;br&gt;&lt;i&gt;no secret ever reaches client code&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="390" height="70" as="geometry"/></mxCell>

    <mxCell id="edgeCtl" value="&lt;b&gt;Edge controls&lt;/b&gt; (app/security, app/auth)&lt;br&gt;token-bucket rate limit per identity + route class&lt;br&gt;client address through declared proxy hops&lt;br&gt;principal resolution - append-only audit_log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="310" height="80" as="geometry"/></mxCell>
    <mxCell id="routers" value="&lt;b&gt;/api/v1 routers&lt;/b&gt; (app/api/v1)&lt;br&gt;auth - research - files - settings&lt;br&gt;health - telemetry&lt;br&gt;&lt;i&gt;boundary 2: the public HTTP surface&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="310" height="80" as="geometry"/></mxCell>
    <mxCell id="sse" value="&lt;b&gt;SSE relay&lt;/b&gt;  GET /research/{id}/events&lt;br&gt;subscribes to the run's Redis channel&lt;br&gt;replays research_events on Last-Event-ID&lt;br&gt;15 s heartbeat comment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="770" y="320" width="300" height="80" as="geometry"/></mxCell>
    <mxCell id="svcRes" value="&lt;b&gt;Research service&lt;/b&gt; (app/research)&lt;br&gt;validate - create run row - enqueue - 202" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e6f2e2;strokeColor=#82b366;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="425" width="310" height="70" as="geometry"/></mxCell>
    <mxCell id="svcFiles" value="&lt;b&gt;Upload API&lt;/b&gt; (app/api + retrieval)&lt;br&gt;25 MiB cap enforced while reading the body;&lt;br&gt;bytes checked against declared type before storage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e6f2e2;strokeColor=#82b366;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="425" width="310" height="70" as="geometry"/></mxCell>
    <mxCell id="svcRead" value="&lt;b&gt;Read models&lt;/b&gt;&lt;br&gt;/sources /evidence /activity /report&lt;br&gt;cursor-paginated, scoped by user_id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e6f2e2;strokeColor=#82b366;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="770" y="425" width="300" height="70" as="geometry"/></mxCell>

    <mxCell id="qJob" value="&lt;b&gt;Job queue&lt;/b&gt;&lt;br&gt;at-least-once (ADR 0005)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="605" width="220" height="55" as="geometry"/></mxCell>
    <mxCell id="qPub" value="&lt;b&gt;Pub/Sub&lt;/b&gt; one channel per run&lt;br&gt;capped buffer, allowed to be lossy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="605" width="210" height="55" as="geometry"/></mxCell>
    <mxCell id="qCache" value="&lt;b&gt;Response cache&lt;/b&gt;&lt;br&gt;closed namespace list (ADR 0019)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="672" width="220" height="55" as="geometry"/></mxCell>
    <mxCell id="qBucket" value="&lt;b&gt;Rate-limit buckets&lt;/b&gt;&lt;br&gt;Redis Lua, in-memory fallback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="672" width="210" height="55" as="geometry"/></mxCell>

    <mxCell id="wRunner" value="&lt;b&gt;Runner / loop / lease&lt;/b&gt; (app/workers)&lt;br&gt;reserve - claim by conditional UPDATE&lt;br&gt;renew heartbeat at every node boundary&lt;br&gt;reconciliation sweep - retry with backoff - drain on shutdown" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="300" height="100" as="geometry"/></mxCell>
    <mxCell id="wGraph" value="&lt;b&gt;LangGraph StateGraph&lt;/b&gt; (ADR 0014)&lt;br&gt;typed ResearchState with reducers&lt;br&gt;Send fan-out - Postgres checkpointer&lt;br&gt;every node wrapped: cancel, FR-8 ceilings, timeout, usage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="830" width="320" height="100" as="geometry"/></mxCell>
    <mxCell id="wAgents" value="&lt;b&gt;Nine agents&lt;/b&gt; (app/agents)&lt;br&gt;planner - 3 researchers behind a router&lt;br&gt;evidence - normalization - verification&lt;br&gt;contradictions - critic - synthesis&lt;br&gt;+ citation validator (calls no model)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="770" y="830" width="300" height="100" as="geometry"/></mxCell>
    <mxCell id="wTools" value="&lt;b&gt;Toolbelt - six tools&lt;/b&gt; (app/sources)&lt;br&gt;search - fetch - parse - SEC - arXiv - GitHub&lt;br&gt;four-layer SSRF guard, revalidated per redirect&lt;br&gt;untrusted-content type - per-call ledger&lt;br&gt;&lt;i&gt;the synthesizer and validator get no belt at all&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ede4f3;strokeColor=#9673a6;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="960" width="300" height="120" as="geometry"/></mxCell>
    <mxCell id="wRag" value="&lt;b&gt;Ingestion and retrieval&lt;/b&gt; (app/retrieval)&lt;br&gt;parse in a killable, scrubbed child process&lt;br&gt;offset-exact chunking (512/64, measured)&lt;br&gt;gateway embeddings, written in batches&lt;br&gt;hybrid: pgvector cosine || Postgres FTS, RRF, MMR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ede4f3;strokeColor=#9673a6;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="960" width="320" height="120" as="geometry"/></mxCell>
    <mxCell id="wProj" value="&lt;b&gt;Projections&lt;/b&gt; (app/evidence, app/reports)&lt;br&gt;graph state -&gt; claims, spans, contradictions&lt;br&gt;source dedup into clusters&lt;br&gt;report assembly, citations FK-enforced&lt;br&gt;&lt;i&gt;one transaction: citations require that order&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ede4f3;strokeColor=#9673a6;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="770" y="960" width="300" height="120" as="geometry"/></mxCell>

    <mxCell id="pg" value="&lt;b&gt;PostgreSQL 17 + pgvector&lt;/b&gt;&lt;br&gt;23 tables - Alembic on two branches (core, vector)&lt;br&gt;document_chunks.embedding vector(768) + generated tsv&lt;br&gt;LangGraph checkpoint tables (migration 0005)&lt;br&gt;research_events (durable log, seq allocated by the insert)&lt;br&gt;run lease: worker_id + heartbeat_at - audit_log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="1200" width="490" height="130" as="geometry"/></mxCell>
    <mxCell id="s3" value="&lt;b&gt;S3 / MinIO&lt;/b&gt; - ObjectStorage protocol (ADR 0010)&lt;br&gt;runs/{run_id}/{kind}/{name}&lt;br&gt;uploads/{user_id}/{kind}/{name}&lt;br&gt;evaluations/{evaluation_id}/{name}&lt;br&gt;content-addressed on the same SHA-256 as documents.content_hash&lt;br&gt;filesystem backend under APP_ENV=test; refused in production" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="610" y="1200" width="460" height="130" as="geometry"/></mxCell>

    <mxCell id="gateway" value="&lt;b&gt;LLM Gateway&lt;/b&gt; (app/models) - one door&lt;br&gt;registry.yaml: provider, tier, context, dated sourced price&lt;br&gt;role + mode -&gt; tier (ADR 0007)&lt;br&gt;retry with jitter - provider failover - concurrency semaphore&lt;br&gt;budget gate BEFORE each call; an unpriced model is refused&lt;br&gt;embeddings cached per text; completions deliberately not" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1175" y="480" width="390" height="150" as="geometry"/></mxCell>
    <mxCell id="provs" value="&lt;b&gt;Model providers&lt;/b&gt;&lt;br&gt;Anthropic&#160;&#160;|&#160;&#160;OpenAI&#160;&#160;|&#160;&#160;Ollama (local)&lt;br&gt;&lt;i&gt;no live model call has been made on this machine&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1175" y="660" width="390" height="90" as="geometry"/></mxCell>
    <mxCell id="net" value="&lt;b&gt;The open internet - BOUNDARY 4&lt;/b&gt;&lt;br&gt;&lt;i&gt;the dangerous one: arbitrary third-party content enters here&lt;/i&gt;&lt;br&gt;&lt;br&gt;search API - arbitrary web pages&lt;br&gt;SEC EDGAR - arXiv - GitHub&lt;br&gt;&lt;br&gt;Controls: deny private/link-local/metadata ranges;&lt;br&gt;resolve and validate every IP before connect and after&lt;br&gt;each redirect; robots.txt; untrusted_block delimiters;&lt;br&gt;a model cites by catalogue number, never an identifier (ADR 0015)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1175" y="790" width="390" height="230" as="geometry"/></mxCell>

    <mxCell id="legend" value="&lt;b&gt;TRUST BOUNDARIES&lt;/b&gt;&lt;br&gt;1&#160; untrusted user input - anything from the browser&lt;br&gt;2&#160; public HTTP surface - authn and rate limiting live here&lt;br&gt;3&#160; async boundary - only a run_id crosses it; the worker re-reads state&lt;br&gt;4&#160; the dangerous one - arbitrary third-party content enters&lt;br&gt;5&#160; data plane - least-privilege credentials, no shared superuser&lt;br&gt;&lt;br&gt;&lt;b&gt;INVARIANTS&lt;/b&gt;&lt;br&gt;- no multi-minute workflow inside a request thread&lt;br&gt;- every loop, tool call and cost is bounded and checked per node&lt;br&gt;- every LLM and tool call is recorded (tokens, cost, latency, status)&lt;br&gt;- retrieved content is data, never instructions&lt;br&gt;- every read is scoped by user_id; every list is paginated&lt;br&gt;- run state is durable and resumable from the last checkpoint&lt;br&gt;- not measured, zero, and not built are three different facts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="440" height="310" as="geometry"/></mxCell>

    <mxCell id="obsLedger" value="&lt;b&gt;The ledger&lt;/b&gt; (ADR 0020)&lt;br&gt;one agent_runs row per node execution;&lt;br&gt;tool_calls and llm_calls hang from it.&lt;br&gt;The current span travels in a ContextVar." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#808080;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="1450" width="350" height="95" as="geometry"/></mxCell>
    <mxCell id="obsProm" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;/metrics on the API;&lt;br&gt;the worker exposes its own port.&lt;br&gt;Scrape config in infra/monitoring." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#808080;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="1450" width="340" height="95" as="geometry"/></mxCell>
    <mxCell id="obsOtel" value="&lt;b&gt;OpenTelemetry&lt;/b&gt;&lt;br&gt;spans at every seam; trace_id and span_id&lt;br&gt;on the trace rows. SDK and exporter load&lt;br&gt;only when an endpoint is configured." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#808080;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="840" y="1450" width="340" height="95" as="geometry"/></mxCell>
    <mxCell id="obsGraf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;dashboard committed as a reviewable file,&lt;br&gt;not something someone once clicked together.&lt;br&gt;LangSmith stays off unless asked." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#808080;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1210" y="1450" width="350" height="95" as="geometry"/></mxCell>

    <mxCell id="e1" value="GET page (RSC shell)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="webapp"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="REST over HTTPS, opaque session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="routers"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="SSE: text/event-stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#2d7dd2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sse" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="routers" target="svcRes"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="token bucket per identity and route class" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;endArrow=open;strokeColor=#997a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="edgeCtl" target="qBucket"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="INSERT research_runs (status=queued)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svcRes" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="enqueue {run_id} -- BOUNDARY 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#b8860b;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="svcRes" target="qJob"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="store upload bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svcFiles" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e9" value="paginated reads, scoped by user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svcRead" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e10" value="reserve (at-least-once)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#b8860b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qJob" target="wRunner"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e11" value="claim by conditional UPDATE; renew lease (ADR 0017)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wRunner" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e12" value="invoke or resume by thread_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#6a4a8c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wRunner" target="wGraph"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e13" value="checkpoint after every node (durability=sync)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wGraph" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e14" value="Send fan-out, bounded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#6a4a8c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wGraph" target="wAgents"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e15" value="role + mode, never a provider" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wAgents" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="gateway" target="provs"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e17" value="web and data researchers only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#6a4a8c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wAgents" target="wTools"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e18" value="guarded HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="wTools" target="net"><mxGeometry relative="1" as="geometry"/></mxCell>
