<mxfile host="app.diagrams.net" agent="aether-docs" version="24.7.17">
  <diagram id="deployment-cicd" name="LLD - deployment and delivery">
<mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="LLD - Deployment topology and the delivery pipeline" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="34" as="geometry"/></mxCell>
    <mxCell id="banner" value="&lt;b&gt;WRITTEN, VALIDATED, NEVER APPLIED.&lt;/b&gt;&#160; There is no AWS account behind this repository. terraform fmt and validate pass; tests/test_infrastructure.py holds all three descriptions (Terraform, Kubernetes, Compose) to the code they deploy. The deploy and eval workflows have never run." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="1820" height="46" as="geometry"/></mxCell>

    <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt; - browser over HTTPS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="135" width="240" height="50" as="geometry"/></mxCell>
    <mxCell id="r53i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="611" y="215" width="78" height="78" as="geometry"/></mxCell>
    <mxCell id="r53t" value="&lt;b&gt;Route 53&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="296" width="140" height="20" as="geometry"/></mxCell>

    <mxCell id="zVpc" value="VPC - network module: two availability zones, public and private subnets, NAT for egress, an S3 gateway endpoint so object traffic never leaves the VPC" style="rounded=1;arcSize=2;html=1;fillColor=#f7f9fc;strokeColor=#5a7fb8;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#3b5b8c;" vertex="1" parent="1"><mxGeometry x="80" y="335" width="1180" height="800" as="geometry"/></mxCell>

    <mxCell id="zPub" value="PUBLIC SUBNETS" style="rounded=1;arcSize=3;html=1;fillColor=#eef5ec;strokeColor=#9ac48b;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#3f6b30;" vertex="1" parent="1"><mxGeometry x="110" y="385" width="1120" height="145" as="geometry"/></mxCell>
    <mxCell id="albi" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1"><mxGeometry x="145" y="420" width="70" height="70" as="geometry"/></mxCell>
    <mxCell id="alb" value="&lt;b&gt;Application Load Balancer&lt;/b&gt; (alb module)&lt;br&gt;TLS termination, HTTP redirected to HTTPS.&lt;br&gt;Two target groups: / to the web service, /api/* to the api service.&lt;br&gt;&lt;i&gt;/metrics is deliberately NOT routed - the scrape is internal, so the&lt;br&gt;telemetry surface is not reachable from the internet (threat model 3.11).&lt;/i&gt;&lt;br&gt;Health checks hit /health/ready, which asks the dependencies, not the process." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="240" y="415" width="960" height="85" as="geometry"/></mxCell>

    <mxCell id="zApp" value="PRIVATE APPLICATION SUBNETS - ECS Fargate (ecs-cluster + ecs-service modules).  Two images, three services." style="rounded=1;arcSize=3;html=1;fillColor=#f7f2fb;strokeColor=#b79bd0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#6a4a8c;" vertex="1" parent="1"><mxGeometry x="110" y="555" width="1120" height="230" as="geometry"/></mxCell>
    <mxCell id="fgw" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="152" y="600" width="56" height="56" as="geometry"/></mxCell>
    <mxCell id="svcWeb" value="&lt;b&gt;web service&lt;/b&gt;&lt;br&gt;image: web.Dockerfile&lt;br&gt;Next.js standalone build&lt;br&gt;&lt;br&gt;ingress from the ALB only&lt;br&gt;holds no secret&lt;br&gt;&lt;i&gt;scales on request rate&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="665" width="330" height="105" as="geometry"/></mxCell>
    <mxCell id="svcApi" value="&lt;b&gt;api service&lt;/b&gt;&lt;br&gt;image: api.Dockerfile, entrypoint &lt;i&gt;api&lt;/i&gt;&lt;br&gt;FastAPI behind the ALB&lt;br&gt;&lt;br&gt;reads provider keys from Secrets Manager&lt;br&gt;&lt;i&gt;scales on request concurrency&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="500" y="665" width="330" height="105" as="geometry"/></mxCell>
    <mxCell id="svcWk" value="&lt;b&gt;worker service&lt;/b&gt;&lt;br&gt;the SAME image, entrypoint &lt;i&gt;worker&lt;/i&gt;&lt;br&gt;&lt;b&gt;no ingress at all&lt;/b&gt; - nothing routes to it&lt;br&gt;&lt;br&gt;egress to the internet through NAT (the toolbelt)&lt;br&gt;&lt;i&gt;scales on queue depth&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="665" width="340" height="105" as="geometry"/></mxCell>

    <mxCell id="migrate" value="&lt;b&gt;migrate task&lt;/b&gt; - the same image's third entrypoint, run ONCE as its own task, after the new task definition is registered and BEFORE the services roll.&#160; &lt;i&gt;alembic upgrade heads&lt;/i&gt; applies both branches (core, vector).&lt;br&gt;The schema is deliberately never rolled back: a failed deployment rolls the code back and leaves the schema forward - safe only because every migration must leave the previous release able to run." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="140" y="805" width="1060" height="70" as="geometry"/></mxCell>

    <mxCell id="zData" value="PRIVATE DATA SUBNETS - no route to the internet.  Least-privilege credentials, no shared superuser (boundary 5)." style="rounded=1;arcSize=3;html=1;fillColor=#fff6ec;strokeColor=#e0b273;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#9a5f10;" vertex="1" parent="1"><mxGeometry x="110" y="900" width="1120" height="215" as="geometry"/></mxCell>
    <mxCell id="rdsi" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="152" y="940" width="52" height="52" as="geometry"/></mxCell>
    <mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL + pgvector&lt;/b&gt;&lt;br&gt;(database module)&lt;br&gt;the system of record, and the vector&lt;br&gt;index co-located in it&lt;br&gt;&lt;i&gt;scales on data volume and IOPS&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="220" y="940" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="ecti" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.elasticache;" vertex="1" parent="1"><mxGeometry x="512" y="940" width="52" height="52" as="geometry"/></mxCell>
    <mxCell id="redis" value="&lt;b&gt;ElastiCache Redis&lt;/b&gt; (cache module)&lt;br&gt;queue, pub/sub fan-out, response cache,&lt;br&gt;rate-limit buckets, locks&lt;br&gt;&lt;i&gt;scales on job throughput&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="580" y="940" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="s3i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.simple_storage_service;" vertex="1" parent="1"><mxGeometry x="872" y="940" width="52" height="52" as="geometry"/></mxCell>
    <mxCell id="s3" value="&lt;b&gt;S3&lt;/b&gt; (storage module)&lt;br&gt;raw HTML, PDFs, parsed documents,&lt;br&gt;uploads, generated reports, eval artifacts&lt;br&gt;&lt;i&gt;reached through the VPC gateway endpoint&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="940" y="940" width="260" height="100" as="geometry"/></mxCell>

    <mxCell id="seci" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1322" y="150" width="52" height="52" as="geometry"/></mxCell>
    <mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt; (secrets module)&lt;br&gt;provider keys and database credentials injected&lt;br&gt;into the task definition. Server-side only:&lt;br&gt;never shipped to the browser, never placed in an&lt;br&gt;LLM context or a URL, never read outside the typed&lt;br&gt;settings layer." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fdf0ef;strokeColor=#d99b95;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1390" y="135" width="490" height="90" as="geometry"/></mxCell>

    <mxCell id="mon" value="&lt;b&gt;Monitoring&lt;/b&gt; (infra/monitoring)&lt;br&gt;Prometheus scrapes /metrics on the api and the worker's own port;&lt;br&gt;the Grafana dashboard is a committed, reviewable file.&lt;br&gt;OpenTelemetry spans export only when an endpoint is configured -&lt;br&gt;the SDK and exporter are not even imported otherwise." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#808080;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1322" y="250" width="558" height="90" as="geometry"/></mxCell>

    <mxCell id="zCi" value="CI/CD - five workflows, split by cost (.github/workflows).  actionlint with shellcheck passes on all five." style="rounded=1;arcSize=3;html=1;fillColor=#f4f4f4;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1300" y="370" width="580" height="420" as="geometry"/></mxCell>
    <mxCell id="wfCi" value="&lt;b&gt;ci&lt;/b&gt; - format, lint, typecheck, and one aggregate check so the branch rule has a single required job" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1325" y="415" width="530" height="50" as="geometry"/></mxCell>
    <mxCell id="wfTest" value="&lt;b&gt;test&lt;/b&gt; - the suites, against a real postgres and a real redis service container; pgvector/pgvector:pg17 covers the vector line this machine cannot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1325" y="480" width="530" height="55" as="geometry"/></mxCell>
    <mxCell id="wfBuild" value="&lt;b&gt;build&lt;/b&gt; - both images: built, RUN, scanned, then pushed by digest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1325" y="550" width="530" height="45" as="geometry"/></mxCell>
    <mxCell id="wfEval" value="&lt;b&gt;eval&lt;/b&gt; - the benchmark, guarded on credentials and an explicit variable.&#160;&lt;i&gt;Never run: each case is a real research run that costs money.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1325" y="610" width="530" height="55" as="geometry"/></mxCell>
    <mxCell id="wfDeploy" value="&lt;b&gt;deploy&lt;/b&gt; - build, migrate, roll, smoke, roll back.&#160;&lt;i&gt;Never run: no AWS account, no provider credentials.&lt;/i&gt;&lt;br&gt;scripts/smoke.py is stdlib only and asks the deployment from outside whether it WORKS, not whether it is running." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1325" y="680" width="530" height="80" as="geometry"/></mxCell>

    <mxCell id="decisions" value="&lt;b&gt;FOUR DEPLOYMENT DECISIONS ASSERTED BY TESTS, NOT LEFT TO REVIEW&lt;/b&gt;&lt;br&gt;&lt;br&gt;1&#160; images are scanned &lt;i&gt;before&lt;/i&gt; they are pushed&lt;br&gt;2&#160; deployment is &lt;i&gt;by digest&lt;/i&gt; - a tag can be moved after a deployment decided to trust it&lt;br&gt;3&#160; the rollback target is recorded &lt;i&gt;before&lt;/i&gt; anything changes&lt;br&gt;4&#160; the migration runs &lt;i&gt;after&lt;/i&gt; the new task definition is registered and &lt;i&gt;before&lt;/i&gt; the services roll&lt;br&gt;&lt;br&gt;tests/test_workflows.py asserts what actionlint and shellcheck cannot see." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="815" width="580" height="160" as="geometry"/></mxCell>
    <mxCell id="k8s" value="&lt;b&gt;infra/kubernetes&lt;/b&gt; - the portability escape hatch ADR 0008 names: the same three process types as Deployments, so the ECS choice is reversible. Never applied either.&lt;br&gt;&lt;b&gt;infra/docker/compose&lt;/b&gt; - the whole stack under the &lt;i&gt;app&lt;/i&gt; profile. Not built here: there is no Docker on this machine, so CI builds the images." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f4f4f4;strokeColor=#b3b3b3;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="995" width="580" height="120" as="geometry"/></mxCell>

    <mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="users" target="r53i"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d2" value="alias record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r53i" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d3" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#6a4a8c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alb" target="svcWeb"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d4" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#6a4a8c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alb" target="svcApi"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="svcApi" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="svcApi" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="svcWk" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="svcWk" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="svcWk" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d10" value="alembic upgrade heads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="migrate" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d11" value="injected at task start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="secrets" target="svcApi"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="secrets" target="svcWk"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d13" value="registers the task definition, then rolls each service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#808080;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="wfDeploy" target="zApp"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="d14" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;strokeColor=#808080;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mon" target="svcWk"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
